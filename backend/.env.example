# ─────────────────────────────────────────────
#  ScaleLab AI — Backend Environment Variables
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in values.
#  .env is git-ignored; never commit real secrets.

# Database
# SQLite (default, zero-config) — or swap in a postgres:// URL
DATABASE_URL=sqlite:///./scalelab.db

# AI Provider
# Options: mock | openai | anthropic
#   mock      — fully algorithmic analysis, no API key needed (default)
#   openai    — GPT-4o via OpenAI API
#   anthropic — Claude via Anthropic API
AI_PROVIDER=mock

# API Keys (only needed when AI_PROVIDER is not "mock")
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
